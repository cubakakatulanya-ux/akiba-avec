<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Akiba ne demande aucune permission : pas de réseau, pas de localisation, pas de contacts.
       Le cahier vit dans le terminal, et rien n'en sort sans un geste du bureau. C'est aussi ce
       qui rend l'installation hors Play Store acceptable : il n'y a rien à accorder. -->

  <!-- Depuis Android 11, une application ne voit pas les autres sans le déclarer. Akiba a besoin
       de savoir une seule chose : si RawBT est installée, pour ne pas proposer au bureau une voie
       d'impression qui n'existe pas sur ce terminal. Rien d'autre n'est demandé. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="rawbt" />
    </intent>
  </queries>

  <application
      android:allowBackup="false"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:label="@string/app_name"
      android:supportsRtl="false"
      android:theme="@style/AkibaTheme"
      android:hardwareAccelerated="true">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|locale"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Le verrou contre la suppression par erreur. Tant que le bureau l'a activé, le
         téléphone refuse de supprimer Akiba : il faut d'abord retirer la protection, ce qui
         ne se fait pas sans le vouloir. Aucun pouvoir n'est réclamé — la liste, dans
         res/xml/garde_suppression.xml, est vide. -->
    <receiver
        android:name=".GardeSuppression"
        android:label="@string/garde_nom"
        android:description="@string/garde_explication"
        android:permission="android.permission.BIND_DEVICE_ADMIN"
        android:exported="true">
      <meta-data
          android:name="android.app.device_admin"
          android:resource="@xml/garde_suppression" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
