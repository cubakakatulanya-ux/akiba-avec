<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Akiba ne demande qu'une seule permission : pas de réseau, pas de localisation, pas de
       contacts, pas de stockage. Le cahier vit dans le terminal, et rien n'en sort sans un
       geste du bureau.

       L'appareil photo est l'exception, et Android ne la demande qu'au moment où l'on vise :
       recevoir une AVEC neuve en photographiant l'image montrée par l'animatrice, et vérifier
       une carte de membre. Refusée, l'application continue de marcher — il reste le fichier.
       Elle n'est pas obligatoire : un terminal sans appareil photo installe quand même. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />

  <!-- Depuis Android 11, une application ne voit pas les autres sans le déclarer. Akiba déclare
       ici les seules questions qu'elle pose, toutes au sujet de l'impression : telle application
       ou tel service d'imprimante est-il présent sur ce terminal ? La réponse sert à ne pas
       proposer au bureau une voie qui n'existe pas, et à reconnaître l'imprimante intégrée d'un
       modèle qu'on ne connaît pas encore. Akiba ne voit rien d'autre du téléphone. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="rawbt" />
    </intent>
    <!-- Les services d'impression connus des terminaux de caisse. Akiba demande seulement s'ils
         existent, pour pouvoir dire au bureau ce que son terminal héberge. Cette liste doit
         rester la même que celle d'Imprimante.java. -->
    <intent><action android:name="com.iposprinter.iposprinterservice.IPosPrinterService" /></intent>
    <intent><action android:name="woyou.aidlservice.jiuiv5.IWoyouService" /></intent>
    <intent><action android:name="com.sunmi.extprinterservice.ExtPrinterService" /></intent>
    <intent><action android:name="com.telpo.tps550.api.printer.PrinterService" /></intent>
    <intent><action android:name="com.pos.sdk.printer.IPrinterService" /></intent>
    <intent><action android:name="com.ubx.usdk.PrinterService" /></intent>
    <intent><action android:name="net.posprinter.service.PosprinterService" /></intent>
    <intent><action android:name="com.senraise.printer.PrinterService" /></intent>
    <intent><action android:name="com.senraise.sdk.PrinterService" /></intent>
    <intent><action android:name="android.printservice.PrintService" /></intent>
    <package android:name="com.iposprinter.iposprinterservice" />
    <package android:name="woyou.aidlservice.jiuiv5" />
    <package android:name="com.sunmi.printerservice" />
    <package android:name="com.senraise.printer" />
    <package android:name="com.senraise.sdk" />
    <package android:name="com.senraise.printservice" />
    <package android:name="com.android.bips" />
    <package android:name="ru.a402d.rawbtprinter" />
  </queries>

  <application
      android:allowBackup="false"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:label="@string/app_name"
      android:supportsRtl="false"
      android:theme="@style/AkibaTheme"
      android:hardwareAccelerated="true">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|locale"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <!-- « Ouvrir avec Akiba ». Le cahier d'un groupe arrive presque toujours par WhatsApp,
           et c'est là que le chemin se perdait : il fallait enregistrer le fichier, puis le
           retrouver dans un gestionnaire de fichiers que personne au village ne connaît. En
           se déclarant capable d'ouvrir un .akiba, l'application devient un choix dans le
           message lui-même : on touche le fichier, on choisit Akiba, et il ne reste que les
           huit signes à taper. Le fichier reste chiffré : rien n'entre sans le code. -->
      <!-- Android assemble les <data> d'un même filtre en toutes les combinaisons possibles :
           schéma × type × chemin. Une seule ligne par chemin suffit donc, et le type reste
           « n'importe lequel » parce que WhatsApp nomme rarement un .akiba correctement —
           c'est l'extension qui décide, jamais le type annoncé.

           Les quatre chemins répétés ne sont pas une maladresse : pathPattern ne connaît ni
           l'échappement ni la paresse, et « .* » avale tout jusqu'au bout. « Cahier.du.14.akiba »
           ne passe donc pas par « .*\\.akiba ». Il faut un motif par point supplémentaire, et
           quatre couvrent largement ce qu'un téléphone fabrique comme nom de fichier. -->
      <intent-filter android:label="Ouvrir avec Akiba">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="content" />
        <data android:scheme="file" />
        <data android:host="*" />
        <data android:mimeType="*/*" />
        <data android:pathPattern=".*\\.akiba" />
        <data android:pathPattern=".*\\..*\\.akiba" />
        <data android:pathPattern=".*\\..*\\..*\\.akiba" />
        <data android:pathPattern=".*\\..*\\..*\\..*\\.akiba" />
        <data android:pathPattern=".*\\.kitabu" />
        <data android:pathPattern=".*\\..*\\.kitabu" />
        <data android:pathPattern=".*\\..*\\..*\\.kitabu" />
        <data android:pathPattern=".*\\..*\\..*\\..*\\.kitabu" />
      </intent-filter>
      <!-- Un fichier posé par un gestionnaire de fichiers arrive parfois sans type du tout.
           Le filtre précédent exige un type — Android ne fait pas correspondre un <data>
           mimeType à une intention qui n'en porte aucun — alors celui-ci rattrape ce cas. -->
      <intent-filter android:label="Ouvrir avec Akiba">
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="file" />
        <data android:scheme="content" />
        <data android:host="*" />
        <data android:pathPattern=".*\\.akiba" />
        <data android:pathPattern=".*\\..*\\.akiba" />
        <data android:pathPattern=".*\\..*\\..*\\.akiba" />
        <data android:pathPattern=".*\\.kitabu" />
        <data android:pathPattern=".*\\..*\\.kitabu" />
        <data android:pathPattern=".*\\..*\\..*\\.kitabu" />
      </intent-filter>
      <!-- Et « Partager vers Akiba », pour les applications qui envoient un fichier sans nom
           reconnaissable. On s'en tient aux deux types qu'un cahier porte réellement : ajouter
           text/plain ferait apparaître Akiba dans le partage de n'importe quel message, et un
           choix qui s'affiche partout finit par ne plus rien vouloir dire. Ce qui entre par ici
           est vérifié avant d'ouvrir quoi que ce soit. -->
      <intent-filter android:label="Envoyer à Akiba">
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="application/octet-stream" />
        <data android:mimeType="application/json" />
      </intent-filter>
    </activity>

    <!-- Le verrou contre la suppression par erreur. Tant que le bureau l'a activé, le
         téléphone refuse de supprimer Akiba : il faut d'abord retirer la protection, ce qui
         ne se fait pas sans le vouloir. Aucun pouvoir n'est réclamé — la liste, dans
         res/xml/garde_suppression.xml, est vide. -->
    <receiver
        android:name=".GardeSuppression"
        android:label="@string/garde_nom"
        android:description="@string/garde_explication"
        android:permission="android.permission.BIND_DEVICE_ADMIN"
        android:exported="true">
      <meta-data
          android:name="android.app.device_admin"
          android:resource="@xml/garde_suppression" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
      </intent-filter>
    </receiver>

    <!-- Voir le reste du manifeste : Akiba ne demandait aucune autorisation, et c'était un point
         d'honneur. La caméra en ajoute une seule, demandée au moment précis où le secrétaire
         vise l'image que montre l'animatrice — pour recevoir une AVEC neuve sans fichier à
         déplacer, et pour vérifier une carte de membre. Refusée, l'application continue : il
         reste le fichier. Le téléphone qui n'a pas d'appareil photo installe quand même. -->
    <!-- Par où sort un fichier : le cahier envoyé à l'animateur, la sauvegarde, l'export Excel.
         Akiba écrit dans son propre cache et laisse Android porter le fichier jusqu'à WhatsApp,
         au Bluetooth ou à Fichiers. Aucune autorisation sur le téléphone n'est demandée, et rien
         d'autre que ce dossier n'est accessible aux autres applications. -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fichiers"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/fichiers_partages" />
    </provider>
  </application>
</manifest>
